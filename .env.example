# Example environment configuration for CryptoAnalyzer.
#
# This project does NOT use any secrets or API keys. The only environment
# variable it reads is the log verbosity below. There is no dotenv auto-loader,
# so export the variable in your shell (e.g. `export CRYPTOANALYZER_LOG=DEBUG`)
# or prefix the command; copying this file to `.env` alone will not load it.

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL (default: INFO)
CRYPTOANALYZER_LOG=INFO
